# PORT: Port the POLARIS server listens on (defaults to 3000).
PORT=3000

# APP_URL: Public URL where this app is hosted.
# Used for self-referential links and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_TOKEN: acts as an admin for the review tools (Admin page, Outreach studio)
# and as a Bearer token for /api/admin/*. Accounts for people are created at /login.
# If unset, a random token is generated and printed at startup.
ADMIN_TOKEN=

# DB_PATH: SQLite database file (default: data/polaris.db). Seeded on first run.
# DB_PATH=data/polaris.db

# UPLOAD_DIR: where uploaded files are stored and served from /uploads.
# UPLOAD_DIR=uploads
# MAX_UPLOAD=100mb

# DEMO_ACCOUNTS: demo logins user1 / 1234 (contributor) and admin / 0786 (admin).
# On by default for local demos. Set DEMO_ACCOUNTS=off on any public deployment.
# DEMO_ACCOUNTS=on

# OPEN_DATA=off skips loading the Crossref / PANGAEA snapshot (server/data/open-data.json).
# OPEN_DATA=on

# --- Polar AI (all optional; without them the assistant runs in offline extractive mode) ---
# GEMINI_API_KEY: enables Gemini as the first-choice generator.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Semantic retrieval (optional ML service from ml/serve.ps1) ---
# ML_SERVICE_URL=http://127.0.0.1:8765
