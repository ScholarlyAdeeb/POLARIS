# PORT: Port the POLARIS server listens on (defaults to 3000).
PORT=3000

# APP_URL: Public URL where this app is hosted.
# Used for self-referential links and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_TOKEN: acts as an admin for the review tools (Admin page, Outreach studio)
# and as a Bearer token for /api/admin/*. Accounts for people are created at /login.
# If unset, a random token is generated and printed at startup.
ADMIN_TOKEN=

# DATABASE_URL: PostgreSQL connection string (Neon, Supabase, Render Postgres or local).
# Tables are created and seeded on first start.
DATABASE_URL=

# TRUST_PROXY: number of reverse proxies in front of the app (e.g. 1 behind nginx), so client IPs
# and https are read from X-Forwarded-*. Set automatically to 1 on Vercel and Render.
# TRUST_PROXY=1

# UPLOAD_DIR: where uploaded files are stored and served from /uploads.
# UPLOAD_DIR=uploads
# MAX_UPLOAD=100mb

# DEMO_ACCOUNTS: demo logins user1 / 1234 (contributor) and admin / 0786 (admin).
# On by default for local demos. Set DEMO_ACCOUNTS=off on any public deployment.
# DEMO_ACCOUNTS=on

# OPEN_DATA=off skips loading the Crossref / PANGAEA snapshot (server/data/open-data.json).
# OPEN_DATA=on

# --- Ask POLARIS (RAG over the records researchers share; open models from Hugging Face) ---
# Local backend (default off Vercel): models run inside this server. Download them once with
#   npm run rag:models     (bge-small-en-v1.5 embeddings + Qwen2.5-1.5B-Instruct, ~1.8 GB)
# Hosted backend (default on Vercel): same embedding model + an open chat model via Hugging Face
# Inference Providers. Needs a free token from https://huggingface.co/settings/tokens
# HF_TOKEN=
# RAG=on                      off hides Ask POLARIS
# RAG_BACKEND=local           local | hosted
# RAG_LLM=on                  off = retrieval + extractive answers, no language model
# RAG_LLM_MODEL=onnx-community/Qwen2.5-1.5B-Instruct
# RAG_HF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# RAG_DEVICE=cpu              cpu | dml (Windows GPU) | cuda (Linux)
# RAG_MODEL_DIR=data/models
