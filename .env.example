# PORT: Port the POLARIS server listens on (defaults to 3000).
PORT=3000

# APP_URL: Public URL where this app is hosted.
# Used for self-referential links and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_TOKEN: Bearer token for /api/admin/* (create/edit archive records,
# uploads, proposal review, outreach drafts). If unset, a random token is
# generated and printed at startup.
ADMIN_TOKEN=

# DB_PATH: SQLite database file (default: data/polaris.db). Seeded on first run.
# DB_PATH=data/polaris.db

# UPLOAD_DIR: where admin uploads are stored and served from /uploads.
# UPLOAD_DIR=uploads

# --- Polar AI (all optional; without them the assistant runs in offline extractive mode) ---
# GEMINI_API_KEY: enables Gemini as the first-choice generator.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Local fallback: install Ollama and `ollama pull llama3.1:8b`.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b

# --- Semantic retrieval (optional ML service from ml/serve.ps1) ---
# ML_SERVICE_URL=http://127.0.0.1:8765
