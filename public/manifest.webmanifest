{
  "name": "POLARIS – Indian Polar Science Knowledge Platform",
  "short_name": "POLARIS",
  "description": "Expedition reports, datasets, publications, photographs, videos and activities from India's polar programme, mapped and linked.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8f9ff",
  "theme_color": "#00677d",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/polaris-emblem.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
